{
    "name": "RGLM (Logistic) - Short-Long Test 04 (rlm_04.json)",
    "description": "Used for a full, not to long, testing the complete worker chain.",
    "base_dir": "will/be/overwritten/by/python/during/unittesting",
    "output": "rglm_logistic_model_ec_20_TEST04.dat",
    "use_cache": true,
    "stat_model": {
        "frequency_cut_off": 10,
        "logit_clipping": 0.01,
        "ridge_regularization": 0.01,
    },
    "optimization": {
        "max_iters": 100,
        "m": 19,
        "c1": 0.0001,
        "c2": 0.9,
        "min_grad": [1e-4, 5],
        "min_p_fun_decrease": [1e-5, 5],
        "log_every_n": 1,
        "save_every_n": 100
    },
    "analytics": {
        "report_file_name": "model_analytics_report.txt",
        "detailed_report": ["EDGE", "LMC"]
    },
    "regab_data_set": {
        "regab_db_connection": {
            "dbname": "tst_regab",
            "user": "tst_regab",
            "host": "localhost"
        },
        "bid": [6],
        "status": ["CMR", "CMS"],
        "ec": 20
    },
    "validation_data_set": {
        "bid": [5],
        "status": ["CMS", "CMR"]
    },
    "feature_set": {
        "intercept": true,
        "pattern_set": {
            "name": "EDGE",
            "patterns": [
                { "name": "EDGE", "mask": "00000000000000FF" }
            ]
        },
        "mobility_set": {
            "name": "MOBILITY",
            "mobility_features": [
                { "name": "LMC", "mask": "FFFFFFFFFFFFFFFF", "amask": "0000000000000000" }
            ]
        }
    }
}
